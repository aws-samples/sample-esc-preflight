{
  "$defs": {
    "CompareSummary": {
      "properties": {
        "config_values": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "products": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "properties": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "resource_types": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "products",
        "resource_types",
        "config_values",
        "properties"
      ],
      "type": "object"
    },
    "CompareWarningCode": {
      "oneOf": [
        {
          "const": "public-data-region-unlisted",
          "description": "No public availability data covers the target: products and config values are\nnot compared.",
          "type": "string"
        },
        {
          "const": "products-unchecked",
          "description": "A Region publishes no product or config value data (China): products and config\nvalues are not compared.",
          "type": "string"
        },
        {
          "const": "properties-unchecked",
          "description": "A Region without a schema bundle, and no live mode for it: properties are not\ncompared.",
          "type": "string"
        }
      ]
    },
    "ComparedSchemas": {
      "properties": {
        "from": {
          "$ref": "#/$defs/SchemaRef"
        },
        "to": {
          "$ref": "#/$defs/SchemaRef"
        },
        "types": {
          "description": "Types whose schema both Regions gave.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "types",
        "from",
        "to"
      ],
      "type": "object"
    },
    "ConfigOut": {
      "properties": {
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "property": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "property"
      ],
      "type": "object"
    },
    "DepthKind": {
      "oneOf": [
        {
          "enum": [
            "instance-type",
            "availability-zone",
            "foundation-model",
            "inference-profile",
            "rds-engine-version",
            "cache-engine-version",
            "cache-node-type",
            "neptune-engine-version",
            "document-db-engine-version",
            "redshift-node-type"
          ],
          "type": "string"
        },
        {
          "const": "rds-instance-class",
          "description": "`engine class`: an RDS DB instance class orderable for the engine; live mode.",
          "type": "string"
        },
        {
          "const": "property",
          "description": "A top-level resource property the target's CloudFormation schema lacks.",
          "type": "string"
        },
        {
          "const": "lambda-architecture",
          "description": "`arm64` as a Lambda function's architecture: the public availability data's\nLambda feature \"Graviton (ARM) Support\" decides.",
          "type": "string"
        }
      ]
    },
    "InputEnvironment": {
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "literal_places": {
          "description": "Property values written for this environment by synthesis or planning.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "zones_used": {
          "description": "Distinct zones of the environment the input uses.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "literal_places"
      ],
      "type": "object"
    },
    "InputKind": {
      "description": "What produced the input; decides which replacement expression applies.",
      "oneOf": [
        {
          "enum": [
            "cloudformation",
            "terraform-plan"
          ],
          "type": "string"
        },
        {
          "const": "cdk-assembly",
          "description": "A CDK cloud assembly, or a template CDK synthesized: edits go to the CDK source.",
          "type": "string"
        },
        {
          "const": "sam",
          "description": "An AWS SAM template.",
          "type": "string"
        }
      ]
    },
    "LiveSources": {
      "properties": {
        "account_id": {
          "type": "string"
        },
        "depth_probes": {
          "items": {
            "$ref": "#/$defs/DepthKind"
          },
          "type": "array"
        },
        "fetched_at": {
          "description": "When the account was read. Scan and plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "read_only_access": {
          "description": "The caller's role has ReadOnlyAccess (or AdministratorAccess) attached, so an\nAccessDenied from a service means the service is not offered.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "account_id"
      ],
      "type": "object"
    },
    "Mode": {
      "description": "Live mode read the target account; public mode used public data only.",
      "enum": [
        "public",
        "live"
      ],
      "type": "string"
    },
    "ProductGroup": {
      "properties": {
        "launch": {
          "description": "Quarter of a planned launch in the target.",
          "type": [
            "string",
            "null"
          ]
        },
        "names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/State"
            },
            {
              "type": "null"
            }
          ],
          "description": "The state in the target; null when the target does not list the products."
        }
      },
      "type": "object"
    },
    "PropertyGap": {
      "properties": {
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resource_type": {
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "missing"
      ],
      "type": "object"
    },
    "PublicSources": {
      "properties": {
        "products_url": {
          "description": "Where product and roadmap states came from: the capabilities API, with the\nKnowledge MCP server for the not-expanding state. Null for China, which\npublishes none.",
          "type": [
            "string",
            "null"
          ]
        },
        "services_url": {
          "description": "Where services and APIs came from: the AWS Knowledge MCP server, or the AWS SDK\nendpoint data for China.",
          "type": [
            "string",
            "null"
          ]
        },
        "types_urls": {
          "description": "Where the CloudFormation types and config values came from: the Builder Center\ncapabilities API, the Knowledge MCP server when the API failed, or a China\nRegion's schema bundle.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Run": {
      "description": "What ran, on what, against what.",
      "properties": {
        "crosses_partition": {
          "description": "The move goes to another partition. Plan; null when the source is unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_environments": {
          "description": "Where the input was synthesized (CDK) or planned (Terraform). Scan.",
          "items": {
            "$ref": "#/$defs/InputEnvironment"
          },
          "type": "array"
        },
        "input_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "What produced the input; picks the `replace` expression. Scan and plan."
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "source_region": {
          "description": "The Region the workload runs in today. Plan and compare; for plan, null when\nneither the input nor `--from` names one.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_account": {
          "description": "The account the input moves to, when `--account` is given.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_region": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "mode",
        "target_region"
      ],
      "type": "object"
    },
    "SchemaRef": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SchemaSource"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "SchemaSource": {
      "oneOf": [
        {
          "const": "bundle",
          "description": "The Region's public schema bundle.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "`cloudformation:DescribeType` in the target account.",
          "type": "string"
        }
      ]
    },
    "SchemaSources": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SchemaSource"
        },
        "types": {
          "description": "Resource types whose schema was read.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "description": "The bundle read, for `bundle`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "types"
      ],
      "type": "object"
    },
    "Sources": {
      "description": "Where the data came from, and when.",
      "properties": {
        "compared_schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparedSchemas"
            },
            {
              "type": "null"
            }
          ],
          "description": "The schemas whose properties were compared. Compare; null when properties were\nnot compared."
        },
        "fetched_at": {
          "description": "When the public data was fetched; `live.fetched_at` is when the account was read.",
          "type": "string"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveSources"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition_data": {
          "description": "botocore release of the bundled partition data. Scan and plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "public": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicSources"
            },
            {
              "type": "null"
            }
          ],
          "description": "The public availability data; null when none covers the target, so live mode\ndecides alone."
        },
        "schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaSources"
            },
            {
              "type": "null"
            }
          ],
          "description": "The target's CloudFormation resource schemas the property checks read. Scan and\nplan; null when none were read."
        },
        "terraform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerraformProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_guide_url": {
          "description": "The ESC User Guide's table of contents, when the target is in its partition.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fetched_at"
      ],
      "type": "object"
    },
    "State": {
      "enum": [
        "available",
        "planned",
        "planning",
        "not-expanding",
        "not-available"
      ],
      "type": "string"
    },
    "TerraformProvenance": {
      "properties": {
        "aws_provider_version": {
          "type": "string"
        },
        "awscc_provider_version": {
          "type": "string"
        }
      },
      "required": [
        "aws_provider_version",
        "awscc_provider_version"
      ],
      "type": "object"
    },
    "TypeGroup": {
      "properties": {
        "product": {
          "description": "The product the types belong to, as the source Region lists it; null for types\nwithout a known product.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/State"
            },
            {
              "type": "null"
            }
          ],
          "description": "The product's state in the target; null when no product is known or the target\ndoes not list it. `available` means the service is there and CloudFormation\nlacks the types."
        },
        "types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Warning": {
      "description": "A run-level condition. `code` is stable and `message` is prose for people;\n`items` names what the condition is about (types, values, rule ids, Regions).",
      "properties": {
        "code": {
          "$ref": "#/$defs/CompareWarningCode"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "config_values": {
      "description": "Config values, such as instance types, the source offers and the target does\nnot.",
      "items": {
        "$ref": "#/$defs/ConfigOut"
      },
      "type": "array"
    },
    "products": {
      "description": "Products and features available in the source Region and not in the target,\nby their state there.",
      "items": {
        "$ref": "#/$defs/ProductGroup"
      },
      "type": "array"
    },
    "properties": {
      "description": "Top-level properties of types both offer that the target's schema lacks.",
      "items": {
        "$ref": "#/$defs/PropertyGap"
      },
      "type": "array"
    },
    "resource_types": {
      "description": "CloudFormation resource types available in the source Region and not in the\ntarget, by product.",
      "items": {
        "$ref": "#/$defs/TypeGroup"
      },
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "schema_version": {
      "const": 2,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "summary": {
      "$ref": "#/$defs/CompareSummary"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run",
    "sources",
    "summary"
  ],
  "title": "CompareOut",
  "type": "object"
}
