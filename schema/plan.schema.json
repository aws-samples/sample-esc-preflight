{
  "$defs": {
    "Boundary": {
      "enum": [
        "global",
        "regional",
        "zonal"
      ],
      "type": "string"
    },
    "ComparedSchemas": {
      "properties": {
        "from": {
          "$ref": "#/$defs/SchemaRef"
        },
        "to": {
          "$ref": "#/$defs/SchemaRef"
        },
        "types": {
          "description": "Types whose schema both Regions gave.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "types",
        "from",
        "to"
      ],
      "type": "object"
    },
    "Content": {
      "oneOf": [
        {
          "enum": [
            "configuration",
            "code",
            "data"
          ],
          "type": "string"
        },
        {
          "const": "supplemental",
          "description": "Logs, metrics and similar records that stay where they were written.",
          "type": "string"
        }
      ]
    },
    "DataDecision": {
      "oneOf": [
        {
          "const": "migrate",
          "description": "Move the data with the resource.",
          "type": "string"
        },
        {
          "const": "recreate",
          "description": "Create new content in the target, such as a new key.",
          "type": "string"
        },
        {
          "const": "drain",
          "description": "Let the source empty before switching over.",
          "type": "string"
        },
        {
          "const": "leave",
          "description": "Keep the history in the source.",
          "type": "string"
        }
      ]
    },
    "DepthKind": {
      "oneOf": [
        {
          "enum": [
            "instance-type",
            "availability-zone",
            "foundation-model",
            "inference-profile",
            "rds-engine-version",
            "cache-engine-version",
            "cache-node-type",
            "neptune-engine-version",
            "document-db-engine-version",
            "redshift-node-type"
          ],
          "type": "string"
        },
        {
          "const": "rds-instance-class",
          "description": "`engine class`: an RDS DB instance class orderable for the engine; live mode.",
          "type": "string"
        },
        {
          "const": "property",
          "description": "A top-level resource property the target's CloudFormation schema lacks.",
          "type": "string"
        },
        {
          "const": "lambda-architecture",
          "description": "`arm64` as a Lambda function's architecture: the public availability data's\nLambda feature \"Graviton (ARM) Support\" decides.",
          "type": "string"
        }
      ]
    },
    "InputEnvironment": {
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "literal_places": {
          "description": "Property values written for this environment by synthesis or planning.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "zones_used": {
          "description": "Distinct zones of the environment the input uses.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "literal_places"
      ],
      "type": "object"
    },
    "InputKind": {
      "description": "What produced the input; decides which replacement expression applies.",
      "oneOf": [
        {
          "enum": [
            "cloudformation",
            "terraform-plan"
          ],
          "type": "string"
        },
        {
          "const": "cdk-assembly",
          "description": "A CDK cloud assembly, or a template CDK synthesized: edits go to the CDK source.",
          "type": "string"
        },
        {
          "const": "sam",
          "description": "An AWS SAM template.",
          "type": "string"
        }
      ]
    },
    "Layer": {
      "enum": [
        "foundation",
        "shared",
        "workload"
      ],
      "type": "string"
    },
    "LiveSources": {
      "properties": {
        "account_id": {
          "type": "string"
        },
        "depth_probes": {
          "items": {
            "$ref": "#/$defs/DepthKind"
          },
          "type": "array"
        },
        "fetched_at": {
          "description": "When the account was read. Scan and plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "read_only_access": {
          "description": "The caller's role has ReadOnlyAccess (or AdministratorAccess) attached, so an\nAccessDenied from a service means the service is not offered.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "account_id"
      ],
      "type": "object"
    },
    "Mechanism": {
      "description": "How a mechanism rule moves a resource, and the AWS page it rests on.",
      "properties": {
        "doc": {
          "type": "string"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/MechanismFallback"
            },
            {
              "type": "null"
            }
          ],
          "description": "The documented alternative for a move across partitions, where `via` does not\nwork or is not documented to work there; resources that take it say `fallback`."
        },
        "holds": {
          "$ref": "#/$defs/Content",
          "description": "What the resource holds: configuration, code, data or supplemental records."
        },
        "scope": {
          "$ref": "#/$defs/Boundary",
          "description": "Where the resource lives: global, regional or zonal."
        },
        "via": {
          "description": "The named mechanism.",
          "type": "string"
        },
        "works_across_partitions": {
          "description": "Whether `via` works across partitions; absent where the documentation does not\nsay.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "via",
        "scope",
        "holds",
        "doc"
      ],
      "type": "object"
    },
    "MechanismFallback": {
      "properties": {
        "doc": {
          "type": "string"
        },
        "via": {
          "type": "string"
        }
      },
      "required": [
        "via",
        "doc"
      ],
      "type": "object"
    },
    "Mode": {
      "description": "Live mode read the target account; public mode used public data only.",
      "enum": [
        "public",
        "live"
      ],
      "type": "string"
    },
    "MovePath": {
      "oneOf": [
        {
          "const": "redeploy",
          "description": "Deploy the input again in the target.",
          "type": "string"
        },
        {
          "const": "replicate",
          "description": "A service mechanism copies the content continuously.",
          "type": "string"
        },
        {
          "const": "restore",
          "description": "Copy a backup, snapshot or export and restore it in the target.",
          "type": "string"
        },
        {
          "const": "blocked",
          "description": "A scan finding blocks the resource in the target.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "No rule says how the resource moves.",
          "type": "string"
        }
      ]
    },
    "PlanResource": {
      "properties": {
        "blocked_by": {
          "description": "Scan findings that block the resource in the target, as cause ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cdk_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataDecision"
            },
            {
              "type": "null"
            }
          ],
          "description": "What happens to the resource's data: migrate, recreate, drain or leave."
        },
        "fallback": {
          "description": "The resource moves by the rule's `fallback`, not by its `via`.",
          "type": "boolean"
        },
        "layer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Layer"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_id": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/MovePath"
        },
        "resource_type": {
          "type": "string"
        },
        "rule": {
          "description": "The mechanism rule, a key of `mechanisms`.",
          "type": [
            "string",
            "null"
          ]
        },
        "wave": {
          "description": "1-based. A resource is in a later wave than everything it references, and\nfoundation, shared and workload resources start at waves 1, 2 and 3. Null for a\nblocked resource, which does not move.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "logical_id",
        "resource_type",
        "path"
      ],
      "type": "object"
    },
    "PlanSummary": {
      "properties": {
        "blocked": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "data_to_move": {
          "description": "Resources whose content is replicated or restored.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "redeploy": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "replicate": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "resources": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "restore": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "waves": {
          "description": "Waves that have resources.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "resources",
        "waves",
        "redeploy",
        "replicate",
        "restore",
        "blocked",
        "unknown",
        "data_to_move"
      ],
      "type": "object"
    },
    "PlanWarningCode": {
      "oneOf": [
        {
          "const": "no-source-region",
          "description": "No source Region: partition limits are not applied.",
          "type": "string"
        },
        {
          "const": "source-is-target",
          "description": "The source Region is the target, as for an input produced for the target.",
          "type": "string"
        },
        {
          "const": "source-mismatch",
          "description": "The input was produced for another Region than `--from`; `--from` is used.",
          "type": "string"
        },
        {
          "const": "blocks-whole-input",
          "description": "Scan findings on the whole input, such as a quota, block every resource.",
          "type": "string"
        },
        {
          "const": "layers-only",
          "description": "The Terraform plan names no references, so waves follow the layers only.",
          "type": "string"
        },
        {
          "const": "reference-cycle",
          "description": "References form a cycle, so the order within it is not decided by them.",
          "type": "string"
        }
      ]
    },
    "PublicSources": {
      "properties": {
        "products_url": {
          "description": "Where product and roadmap states came from: the capabilities API, with the\nKnowledge MCP server for the not-expanding state. Null for China, which\npublishes none.",
          "type": [
            "string",
            "null"
          ]
        },
        "services_url": {
          "description": "Where services and APIs came from: the AWS Knowledge MCP server, or the AWS SDK\nendpoint data for China.",
          "type": [
            "string",
            "null"
          ]
        },
        "types_urls": {
          "description": "Where the CloudFormation types and config values came from: the Builder Center\ncapabilities API, the Knowledge MCP server when the API failed, or a China\nRegion's schema bundle.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Run": {
      "description": "What ran, on what, against what.",
      "properties": {
        "crosses_partition": {
          "description": "The move goes to another partition. Plan; null when the source is unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_environments": {
          "description": "Where the input was synthesized (CDK) or planned (Terraform). Scan.",
          "items": {
            "$ref": "#/$defs/InputEnvironment"
          },
          "type": "array"
        },
        "input_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "What produced the input; picks the `replace` expression. Scan and plan."
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "source_region": {
          "description": "The Region the workload runs in today. Plan and compare; for plan, null when\nneither the input nor `--from` names one.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_account": {
          "description": "The account the input moves to, when `--account` is given.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_region": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "mode",
        "target_region"
      ],
      "type": "object"
    },
    "SchemaRef": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SchemaSource"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "SchemaSource": {
      "oneOf": [
        {
          "const": "bundle",
          "description": "The Region's public schema bundle.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "`cloudformation:DescribeType` in the target account.",
          "type": "string"
        }
      ]
    },
    "SchemaSources": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SchemaSource"
        },
        "types": {
          "description": "Resource types whose schema was read.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "description": "The bundle read, for `bundle`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "types"
      ],
      "type": "object"
    },
    "Sources": {
      "description": "Where the data came from, and when.",
      "properties": {
        "compared_schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparedSchemas"
            },
            {
              "type": "null"
            }
          ],
          "description": "The schemas whose properties were compared. Compare; null when properties were\nnot compared."
        },
        "fetched_at": {
          "description": "When the public data was fetched; `live.fetched_at` is when the account was read.",
          "type": "string"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveSources"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition_data": {
          "description": "botocore release of the bundled partition data. Scan and plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "public": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicSources"
            },
            {
              "type": "null"
            }
          ],
          "description": "The public availability data; null when none covers the target, so live mode\ndecides alone."
        },
        "schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaSources"
            },
            {
              "type": "null"
            }
          ],
          "description": "The target's CloudFormation resource schemas the property checks read. Scan and\nplan; null when none were read."
        },
        "terraform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerraformProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_guide_url": {
          "description": "The ESC User Guide's table of contents, when the target is in its partition.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fetched_at"
      ],
      "type": "object"
    },
    "TerraformProvenance": {
      "properties": {
        "aws_provider_version": {
          "type": "string"
        },
        "awscc_provider_version": {
          "type": "string"
        }
      },
      "required": [
        "aws_provider_version",
        "awscc_provider_version"
      ],
      "type": "object"
    },
    "Warning": {
      "description": "A run-level condition. `code` is stable and `message` is prose for people;\n`items` names what the condition is about (types, values, rule ids, Regions).",
      "properties": {
        "code": {
          "$ref": "#/$defs/PlanWarningCode"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "mechanisms": {
      "additionalProperties": {
        "$ref": "#/$defs/Mechanism"
      },
      "description": "The mechanism rules the resources use, by rule id.",
      "type": "object"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/PlanResource"
      },
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "schema_version": {
      "const": 2,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sources": {
      "$ref": "#/$defs/Sources",
      "description": "The sources of the scan the plan ran: `blocked` depends on them."
    },
    "summary": {
      "$ref": "#/$defs/PlanSummary"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run",
    "sources",
    "summary"
  ],
  "title": "PlanOut",
  "type": "object"
}
