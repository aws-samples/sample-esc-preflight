{
  "$defs": {
    "AccountChecks": {
      "properties": {
        "quotas": {
          "description": "One entry per quota the input counts against.",
          "items": {
            "$ref": "#/$defs/QuotaCheck"
          },
          "type": "array"
        },
        "region_opt_in": {
          "description": "`opt-in-not-required`, `opted-in` or `not-opted-in`, as EC2 reports it.",
          "type": [
            "string",
            "null"
          ]
        },
        "scp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScpCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/Skipped"
          },
          "type": "array"
        },
        "ssm_parameters": {
          "description": "AWS public SSM parameters the input resolves.",
          "items": {
            "$ref": "#/$defs/SsmParameterCheck"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Cause": {
      "description": "`ids` names what fired: hazard kinds, the depth kind, or the guide rule.",
      "properties": {
        "ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/CauseType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CauseType": {
      "description": "What a required change comes from.",
      "oneOf": [
        {
          "const": "availability",
          "description": "The resource is not available in the target.",
          "type": "string"
        },
        {
          "const": "deviation",
          "description": "The ESC User Guide or another AWS page documents the feature as not available.",
          "type": "string"
        },
        {
          "const": "dependency",
          "description": "Something the resource needs stays outside the target (a dependency rule).",
          "type": "string"
        },
        {
          "const": "depth",
          "description": "A property value the target does not offer.",
          "type": "string"
        },
        {
          "const": "hazard",
          "description": "A hardcoded literal.",
          "type": "string"
        },
        {
          "const": "zones",
          "description": "More zones than the target offers.",
          "type": "string"
        },
        {
          "const": "environment",
          "description": "Values written for the input's own environment.",
          "type": "string"
        },
        {
          "const": "account",
          "description": "The target account: Region opt-in, quotas, SCPs, public SSM parameters.",
          "type": "string"
        }
      ]
    },
    "Caveat": {
      "properties": {
        "cdk_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict": {
          "description": "The feature the public data lists as available although the guide says it is\nnot: a guide conflict.",
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "$ref": "#/$defs/DecidedBy"
        },
        "documented": {
          "description": "The documented difference, as the guide or the AWS page states it.",
          "type": "string"
        },
        "logical_id": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "logical_id",
        "resource_type",
        "rule",
        "documented",
        "source",
        "decided_by"
      ],
      "type": "object"
    },
    "ChangeGroup": {
      "description": "One decision and the resources it applies to.",
      "properties": {
        "candidates": {
          "description": "Values the target offers, for the owner to choose from.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cause": {
          "$ref": "#/$defs/Cause"
        },
        "change": {
          "type": "string"
        },
        "consequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "$ref": "#/$defs/DecidedBy"
        },
        "doc": {
          "type": [
            "string",
            "null"
          ]
        },
        "documented": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentedSentence"
            },
            {
              "type": "null"
            }
          ],
          "description": "The documented sentence a deviation or dependency rests on, and its page."
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impact"
            },
            {
              "type": "null"
            }
          ],
          "description": "For hardcoded literals: `breaks` when any literal of the change does."
        },
        "mitigations": {
          "description": "Known ways around the gap, each from an AWS page.",
          "items": {
            "$ref": "#/$defs/Mitigation"
          },
          "type": "array"
        },
        "precondition": {
          "description": "What must hold for a proposed change to be right.",
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "tier",
        "cause",
        "decided_by",
        "change"
      ],
      "type": "object"
    },
    "ComparedSchemas": {
      "properties": {
        "from": {
          "$ref": "#/$defs/SchemaRef"
        },
        "to": {
          "$ref": "#/$defs/SchemaRef"
        },
        "types": {
          "description": "Types whose schema both Regions gave.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "types",
        "from",
        "to"
      ],
      "type": "object"
    },
    "DecidedBy": {
      "description": "The source that decided a finding.",
      "oneOf": [
        {
          "const": "public",
          "description": "The public availability data: the Builder Center capabilities API and the AWS\nKnowledge MCP server, or the AWS China sources.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "A read-only call to the target account.",
          "type": "string"
        },
        {
          "const": "guide",
          "description": "A difference on the ESC User Guide.",
          "type": "string"
        },
        {
          "const": "schema",
          "description": "The target's CloudFormation resource schema.",
          "type": "string"
        },
        {
          "const": "rule",
          "description": "A rule of the bundled rules database with a quoted AWS source.",
          "type": "string"
        },
        {
          "const": "scanner",
          "description": "The scanner itself, from the input and the bundled partition data.",
          "type": "string"
        }
      ]
    },
    "DepthKind": {
      "oneOf": [
        {
          "enum": [
            "instance-type",
            "availability-zone",
            "foundation-model",
            "inference-profile",
            "rds-engine-version",
            "cache-engine-version",
            "cache-node-type",
            "neptune-engine-version",
            "document-db-engine-version",
            "redshift-node-type"
          ],
          "type": "string"
        },
        {
          "const": "rds-instance-class",
          "description": "`engine class`: an RDS DB instance class orderable for the engine; live mode.",
          "type": "string"
        },
        {
          "const": "property",
          "description": "A top-level resource property the target's CloudFormation schema lacks.",
          "type": "string"
        },
        {
          "const": "lambda-architecture",
          "description": "`arm64` as a Lambda function's architecture: the public availability data's\nLambda feature \"Graviton (ARM) Support\" decides.",
          "type": "string"
        }
      ]
    },
    "DepthOut": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/DepthKind"
        },
        "offered": {
          "description": "Null until a source answered, or when none could.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "path": {
          "description": "Property path: `Properties.` first for CloudFormation, `values.` (the plan\nattribute path) for Terraform.",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepthSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "The value as written, `engine version` for engine checks.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "value"
      ],
      "type": "object"
    },
    "DepthSource": {
      "oneOf": [
        {
          "enum": [
            "public",
            "live"
          ],
          "type": "string"
        },
        {
          "const": "schema",
          "description": "The target's CloudFormation resource schema.",
          "type": "string"
        }
      ]
    },
    "Documented": {
      "description": "The differences one guide page documents for a service the input uses.",
      "properties": {
        "differences": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "page",
        "url",
        "differences"
      ],
      "type": "object"
    },
    "DocumentedSentence": {
      "properties": {
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "url"
      ],
      "type": "object"
    },
    "Evidence": {
      "description": "What each source said about one resource.",
      "properties": {
        "live": {
          "description": "The live check found the resource offered. Null without live mode or when the\ncheck could not decide.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "live_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveCheckKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "public": {
          "$ref": "#/$defs/Listed",
          "description": "The public availability data for the type, operation or service. A listed type\ncan still be not available, when its product is not expanding to the target."
        }
      },
      "required": [
        "public"
      ],
      "type": "object"
    },
    "Impact": {
      "description": "What a hardcoded literal does when the input is deployed to the target.",
      "oneOf": [
        {
          "const": "breaks",
          "description": "It refers to another Region or partition, so the deployment fails or misbehaves.",
          "type": "string"
        },
        {
          "const": "portability",
          "description": "It is right for the target, but ties the input to it.",
          "type": "string"
        }
      ]
    },
    "InputEnvironment": {
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "literal_places": {
          "description": "Property values written for this environment by synthesis or planning.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "zones_used": {
          "description": "Distinct zones of the environment the input uses.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "literal_places"
      ],
      "type": "object"
    },
    "InputKind": {
      "description": "What produced the input; decides which replacement expression applies.",
      "oneOf": [
        {
          "enum": [
            "cloudformation",
            "terraform-plan"
          ],
          "type": "string"
        },
        {
          "const": "cdk-assembly",
          "description": "A CDK cloud assembly, or a template CDK synthesized: edits go to the CDK source.",
          "type": "string"
        },
        {
          "const": "sam",
          "description": "An AWS SAM template.",
          "type": "string"
        }
      ]
    },
    "Kind": {
      "oneOf": [
        {
          "const": "substitute",
          "description": "Another AWS service.",
          "type": "string"
        },
        {
          "const": "self-managed",
          "description": "Open source or own code on AWS compute.",
          "type": "string"
        },
        {
          "const": "cross-partition",
          "description": "The service in another partition; a sovereignty and compliance decision.",
          "type": "string"
        }
      ]
    },
    "Listed": {
      "enum": [
        "available",
        "not-available",
        "unknown"
      ],
      "type": "string"
    },
    "LiveCheckKind": {
      "enum": [
        "type-registry",
        "service-api"
      ],
      "type": "string"
    },
    "LiveSources": {
      "properties": {
        "account_id": {
          "type": "string"
        },
        "depth_probes": {
          "items": {
            "$ref": "#/$defs/DepthKind"
          },
          "type": "array"
        },
        "fetched_at": {
          "description": "When the account was read. Scan and plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "read_only_access": {
          "description": "The caller's role has ReadOnlyAccess (or AdministratorAccess) attached, so an\nAccessDenied from a service means the service is not offered.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "account_id"
      ],
      "type": "object"
    },
    "Mitigation": {
      "description": "A mitigation as the report carries it.",
      "properties": {
        "doc": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "summary": {
          "type": "string"
        },
        "tradeoffs": {
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        }
      },
      "required": [
        "id",
        "kind",
        "summary",
        "tradeoffs",
        "doc",
        "validation"
      ],
      "type": "object"
    },
    "Mode": {
      "description": "Live mode read the target account; public mode used public data only.",
      "enum": [
        "public",
        "live"
      ],
      "type": "string"
    },
    "OutOfScope": {
      "description": "A Terraform resource of a provider other than aws or awscc.",
      "properties": {
        "address": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "resource_type",
        "provider"
      ],
      "type": "object"
    },
    "Outcome": {
      "description": "What `--fail-on` decides, per category, from the summary.",
      "properties": {
        "blocker": {
          "description": "Not available, a depth value the target does not offer, a feature the ESC\nUser Guide or another AWS page documents as not available, or an account check\nthat fails.",
          "type": "boolean"
        },
        "disputed": {
          "description": "A disputed or cannot-assess finding, or a guide conflict.",
          "type": "boolean"
        },
        "hazard": {
          "description": "A hardcoded literal, an environment literal or a documented dependency.",
          "type": "boolean"
        }
      },
      "required": [
        "blocker",
        "hazard",
        "disputed"
      ],
      "type": "object"
    },
    "Place": {
      "description": "One value to change: `find` in the value at `path`, replaced by `replace`.",
      "properties": {
        "find": {
          "description": "The literal; absent for a property that is set at all.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Property path: `Properties.` first for CloudFormation, `values.` (the plan\nattribute path) for Terraform.",
          "type": "string"
        },
        "replace": {
          "description": "The expression for the input's kind (see `run.input_kind`); absent where the\nowner decides or chooses among `candidates`.",
          "type": [
            "string",
            "null"
          ]
        },
        "within": {
          "description": "The whole value `find` sits in, cut at 200 characters, to locate it in source;\nfor proposals and flags.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "PublicSources": {
      "properties": {
        "products_url": {
          "description": "Where product and roadmap states came from: the capabilities API, with the\nKnowledge MCP server for the not-expanding state. Null for China, which\npublishes none.",
          "type": [
            "string",
            "null"
          ]
        },
        "services_url": {
          "description": "Where services and APIs came from: the AWS Knowledge MCP server, or the AWS SDK\nendpoint data for China.",
          "type": [
            "string",
            "null"
          ]
        },
        "types_urls": {
          "description": "Where the CloudFormation types and config values came from: the Builder Center\ncapabilities API, the Knowledge MCP server when the API failed, or a China\nRegion's schema bundle.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "QuotaCheck": {
      "properties": {
        "doc": {
          "type": "string"
        },
        "exceeded": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "needed": {
          "description": "What the input alone needs.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quota": {
          "format": "double",
          "type": "number"
        },
        "quota_code": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "service_code": {
          "type": "string"
        },
        "uncounted": {
          "description": "Values the input sets with a reference or function, so they are not counted.\nNegative values (Terraform's `-1`, no reservation) count as zero.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "used": {
          "description": "What the account already uses in the target; null when it could not be read.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "value_source": {
          "$ref": "#/$defs/QuotaSource",
          "description": "`applied` for the account's own value, `default` when none is applied."
        }
      },
      "required": [
        "rule",
        "service_code",
        "quota_code",
        "name",
        "needed",
        "uncounted",
        "quota",
        "value_source",
        "exceeded",
        "doc"
      ],
      "type": "object"
    },
    "QuotaSource": {
      "enum": [
        "applied",
        "default"
      ],
      "type": "string"
    },
    "Roadmap": {
      "description": "The product's state in the target region, when it is not available there.",
      "properties": {
        "launch": {
          "type": [
            "string",
            "null"
          ]
        },
        "product": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/State"
        }
      },
      "required": [
        "product",
        "status"
      ],
      "type": "object"
    },
    "Run": {
      "description": "What ran, on what, against what.",
      "properties": {
        "crosses_partition": {
          "description": "The move goes to another partition. Plan; null when the source is unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "input_environments": {
          "description": "Where the input was synthesized (CDK) or planned (Terraform). Scan.",
          "items": {
            "$ref": "#/$defs/InputEnvironment"
          },
          "type": "array"
        },
        "input_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "What produced the input; picks the `replace` expression. Scan and plan."
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "source_region": {
          "description": "The Region the workload runs in today. Plan and compare; for plan, null when\nneither the input nor `--from` names one.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_account": {
          "description": "The account the input moves to, when `--account` is given.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_region": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "mode",
        "target_region"
      ],
      "type": "object"
    },
    "ScanFinding": {
      "properties": {
        "cdk_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "$ref": "#/$defs/DecidedBy",
          "description": "The source that decided whether the resource is offered. Roadmap states always\ncome from the public availability data."
        },
        "depth": {
          "description": "Property values checked against what the target offers.",
          "items": {
            "$ref": "#/$defs/DepthOut"
          },
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "What each source said, where live mode ran or a source disagrees with `verdict`."
        },
        "logical_id": {
          "type": "string"
        },
        "note": {
          "description": "Why the verdict is what it is; left out where a required change says it.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource_type": {
          "type": "string"
        },
        "roadmap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Roadmap"
            },
            {
              "type": "null"
            }
          ]
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "logical_id",
        "resource_type",
        "verdict",
        "decided_by"
      ],
      "type": "object"
    },
    "SchemaRef": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SchemaSource"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "SchemaSource": {
      "oneOf": [
        {
          "const": "bundle",
          "description": "The Region's public schema bundle.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "`cloudformation:DescribeType` in the target account.",
          "type": "string"
        }
      ]
    },
    "SchemaSources": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SchemaSource"
        },
        "types": {
          "description": "Resource types whose schema was read.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "description": "The bundle read, for `bundle`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "types"
      ],
      "type": "object"
    },
    "ScpCheck": {
      "properties": {
        "policies": {
          "description": "Service control policies that apply to the account, through its OUs and root.",
          "items": {
            "$ref": "#/$defs/ScpPolicy"
          },
          "type": "array"
        },
        "services_denied": {
          "description": "Services the input uses that the SCPs deny in any Region: an allow list at one\nlevel of the organization that does not name them, or a `Deny` of all their\nactions without conditions.",
          "items": {
            "$ref": "#/$defs/ScpServiceDenial"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ScpStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ScpPolicy": {
      "properties": {
        "conditional": {
          "description": "The denying statement has further conditions, such as exempted principals, or\ndenies only some actions.",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ScpVerdict"
        }
      },
      "required": [
        "id",
        "name",
        "verdict",
        "conditional"
      ],
      "type": "object"
    },
    "ScpServiceDenial": {
      "properties": {
        "policy": {
          "description": "The denying policy; null when no policy at the target allows the service.",
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "description": "The IAM service prefix, such as `lambda`.",
          "type": "string"
        },
        "target": {
          "description": "The account, OU or root whose policies deny it.",
          "type": "string"
        }
      },
      "required": [
        "service",
        "target"
      ],
      "type": "object"
    },
    "ScpStatus": {
      "oneOf": [
        {
          "enum": [
            "evaluated"
          ],
          "type": "string"
        },
        {
          "const": "not-in-organization",
          "description": "The account is in no organization, so no SCP applies.",
          "type": "string"
        },
        {
          "const": "management-account",
          "description": "SCPs do not affect the management account.",
          "type": "string"
        }
      ]
    },
    "ScpVerdict": {
      "oneOf": [
        {
          "const": "denies-target",
          "description": "A Deny statement's `aws:RequestedRegion` condition matches the target.",
          "type": "string"
        },
        {
          "const": "allows-target",
          "description": "Its `aws:RequestedRegion` conditions leave the target out of every Deny.",
          "type": "string"
        },
        {
          "const": "not-evaluated",
          "description": "No `aws:RequestedRegion` condition the scanner can evaluate.",
          "type": "string"
        }
      ]
    },
    "Skipped": {
      "properties": {
        "check": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "reason"
      ],
      "type": "object"
    },
    "Sources": {
      "description": "Where the data came from, and when.",
      "properties": {
        "compared_schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparedSchemas"
            },
            {
              "type": "null"
            }
          ],
          "description": "The schemas whose properties were compared. Compare; null when properties were\nnot compared."
        },
        "fetched_at": {
          "description": "When the public data was fetched; `live.fetched_at` is when the account was read.",
          "type": "string"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveSources"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition_data": {
          "description": "botocore release of the bundled partition data. Scan and plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "public": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicSources"
            },
            {
              "type": "null"
            }
          ],
          "description": "The public availability data; null when none covers the target, so live mode\ndecides alone."
        },
        "schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaSources"
            },
            {
              "type": "null"
            }
          ],
          "description": "The target's CloudFormation resource schemas the property checks read. Scan and\nplan; null when none were read."
        },
        "terraform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerraformProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_guide_url": {
          "description": "The ESC User Guide's table of contents, when the target is in its partition.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fetched_at"
      ],
      "type": "object"
    },
    "SsmParameterCheck": {
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "used_by": {
          "description": "Where the input uses it: resource logical ids or `Parameters/<name>`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "exists"
      ],
      "type": "object"
    },
    "State": {
      "enum": [
        "available",
        "planned",
        "planning",
        "not-expanding",
        "not-available"
      ],
      "type": "string"
    },
    "Summary": {
      "properties": {
        "account_blockers": {
          "description": "Account checks that block deployment (see `account`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "available": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "cannot_assess": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "caveats": {
          "description": "Features that work with a documented difference.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "dependencies": {
          "description": "Documented dependencies outside the target, one per resource and rule.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "depth_blockers": {
          "description": "Depth checks whose value the target region does not offer, plus a zone\nshortfall.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "deviation_blockers": {
          "description": "Resources that use a feature the ESC User Guide or another AWS page documents as\nnot available.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "disputed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "divergences": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "environment_literal_places": {
          "description": "Property values written for the input's own environment (see\n`run.input_environments`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "fixes": {
          "description": "Required changes by tier: applied as stated, applied after a yes, owner decides.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "flags": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "guide_conflicts": {
          "description": "Guide restrictions the public availability data contradicts; warnings, not blockers.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "hazards": {
          "description": "Property values with a hardcoded hazard; each is one place to fix.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "hazards_breaking": {
          "description": "Hazards with a literal that breaks in the target, and hazards whose literals\nonly tie the input to one Region or account; together `hazards`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "hazards_portability": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "not_available": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "planned": {
          "description": "Findings whose product has a planned launch quarter.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "proposals": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "resources": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "resources",
        "available",
        "not_available",
        "disputed",
        "cannot_assess",
        "planned",
        "hazards",
        "hazards_breaking",
        "hazards_portability",
        "environment_literal_places",
        "divergences",
        "depth_blockers",
        "account_blockers",
        "deviation_blockers",
        "guide_conflicts",
        "caveats",
        "dependencies",
        "fixes",
        "proposals",
        "flags"
      ],
      "type": "object"
    },
    "Target": {
      "description": "A resource a change applies to, and where in it.",
      "properties": {
        "cdk_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical_id": {
          "description": "The logical id, Terraform address, `Outputs/<name>`, `Globals/<section>`,\n`Parameters/<name>`, or `*` for the whole input.",
          "type": "string"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "type": "array"
        },
        "reason": {
          "description": "Why the change exists, where `places` and the group do not say it.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource_type": {
          "description": "The resource type, for changes that are not about a hardcoded literal.",
          "type": [
            "string",
            "null"
          ]
        },
        "roadmap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Roadmap"
            },
            {
              "type": "null"
            }
          ],
          "description": "The product's state in the target, for a resource that is not available."
        }
      },
      "required": [
        "logical_id"
      ],
      "type": "object"
    },
    "TerraformProvenance": {
      "properties": {
        "aws_provider_version": {
          "type": "string"
        },
        "awscc_provider_version": {
          "type": "string"
        }
      },
      "required": [
        "aws_provider_version",
        "awscc_provider_version"
      ],
      "type": "object"
    },
    "Tier": {
      "enum": [
        "fix",
        "propose",
        "flag"
      ],
      "type": "string"
    },
    "Validation": {
      "oneOf": [
        {
          "const": "documented",
          "description": "An AWS page describes it.",
          "type": "string"
        },
        {
          "const": "field-proven",
          "description": "Deployed and tested by someone who reported it, in addition.",
          "type": "string"
        },
        {
          "const": "deprecated",
          "description": "No longer needed or no longer right, kept for the record; never reported.",
          "type": "string"
        }
      ]
    },
    "Verdict": {
      "oneOf": [
        {
          "enum": [
            "available",
            "not-available"
          ],
          "type": "string"
        },
        {
          "const": "disputed",
          "description": "The sources disagree, or the type exists while its product is not launched.",
          "type": "string"
        },
        {
          "const": "cannot-assess",
          "description": "No source knows the resource.",
          "type": "string"
        }
      ]
    },
    "Warning": {
      "description": "A run-level condition. `code` is stable and `message` is prose for people;\n`items` names what the condition is about (types, values, rule ids, Regions).",
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "WarningCode": {
      "oneOf": [
        {
          "const": "input-region-mismatch",
          "description": "The input was produced for another Region than the target.",
          "type": "string"
        },
        {
          "const": "public-data-unknown",
          "description": "The public availability data does not know some types, services or operations.",
          "type": "string"
        },
        {
          "const": "public-data-region-unlisted",
          "description": "No public availability data covers the target; live mode decides alone.",
          "type": "string"
        },
        {
          "const": "values-unchecked",
          "description": "No source answered for instance types, engine versions or node types the input\nsets (AWS China publishes none), so they were not checked.",
          "type": "string"
        },
        {
          "const": "guide-conflict",
          "description": "The ESC User Guide and the public availability data disagree.",
          "type": "string"
        },
        {
          "const": "stale-rules",
          "description": "Rules matched, but the guide no longer contains their sentence.",
          "type": "string"
        },
        {
          "const": "properties-unchecked",
          "description": "No schema of the target was read, so properties were not checked.",
          "type": "string"
        },
        {
          "const": "account-checks-skipped",
          "description": "Live mode could not run some account checks.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccountChecks"
        },
        {
          "type": "null"
        }
      ],
      "description": "Live mode's checks of the target account."
    },
    "available": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "With `--all`: the available resources, logical ids by resource type.",
      "type": "object"
    },
    "caveats": {
      "description": "Features that work with a documented difference, and guide restrictions the\npublic data contradicts (`conflict`).",
      "items": {
        "$ref": "#/$defs/Caveat"
      },
      "type": "array"
    },
    "documented_differences": {
      "description": "With `--all`: every difference the ESC User Guide documents for the services in\nthe input.",
      "items": {
        "$ref": "#/$defs/Documented"
      },
      "type": "array"
    },
    "findings": {
      "description": "Resources that need action or verification; with `--all`, also available\nresources whose depth checks or sources say something.",
      "items": {
        "$ref": "#/$defs/ScanFinding"
      },
      "type": "array"
    },
    "out_of_scope": {
      "description": "Terraform resources of providers other than aws and awscc.",
      "items": {
        "$ref": "#/$defs/OutOfScope"
      },
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "required_changes": {
      "description": "The actions, grouped: one entry per decision, with the resources it applies to.",
      "items": {
        "$ref": "#/$defs/ChangeGroup"
      },
      "type": "array"
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "schema_version": {
      "const": 2,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run",
    "sources",
    "summary",
    "outcome"
  ],
  "title": "Scan",
  "type": "object"
}
