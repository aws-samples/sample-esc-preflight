      "tier": "propose",
      "reason": "hardcoded `111122223333` at values.service_role",
      "change": "Use the deployment account instead of `111122223333`.",
      "precondition": "The value is the account the stack deploys to, not another account such as a central logging or an AWS-owned account.",
      "edits": [
        {
          "path": "values.service_role",
          "find": "111122223333",
          "replace": {
            "cloudformation": "${AWS::AccountId}",
            "cdk": "${Aws.ACCOUNT_ID}",
            "terraform": "${data.aws_caller_identity.current.account_id}"
          }
        }
      ]
    },
    {
      "logical_id": "aws_iam_policy.bedrock",
      "tier": "fix",
      "reason": "hardcoded `arn:aws:` at values.policy.Statement[0].Resource[0]",
      "change": "Build the ARN from the partition instead of the literal.",
      "edits": [
        {
          "path": "values.policy.Statement[0].Resource[0]",
          "find": "arn:aws:",
          "replace": {
            "cloudformation": "arn:${AWS::Partition}:",
            "cdk": "arn:${Aws.PARTITION}:",
            "terraform": "arn:${data.aws_partition.current.partition}:"
          }
        }
