      "change": "Not available in the target region. Remove the resource from the deployment there or replace it with a service the region offers."
    },
    {
      "logical_id": "Fn",
      "tier": "fix",
      "reason": "hardcoded `amazonaws.com` at Properties.Environment.Variables.QUEUE_URL",
      "change": "Build the host name from the partition's DNS suffix instead of the literal.",
      "edits": [
        {
          "path": "Properties.Environment.Variables.QUEUE_URL",
          "find": "amazonaws.com",
          "replace": {
            "cloudformation": "${AWS::URLSuffix}",
            "cdk": "${Aws.URL_SUFFIX}",
            "terraform": "${data.aws_partition.current.dns_suffix}"
          }
        }
      ]
    },
    {
      "logical_id": "Fn",
      "tier": "propose",
      "reason": "hardcoded `eu-central-1` at Properties.Environment.Variables.QUEUE_URL",
      "change": "Use the deployment Region instead of `eu-central-1`.",
      "precondition": "The value means the Region the stack deploys to. The input does not say which Region it was written for.",
      "edits": [
        {
          "path": "Properties.Environment.Variables.QUEUE_URL",
          "find": "eu-central-1",
          "replace": {
            "cloudformation": "${AWS::Region}",
            "cdk": "${Aws.REGION}",
            "terraform": "${data.aws_region.current.region}"
          }
        }
      ]
    },
    {
      "logical_id": "FnRole",
      "tier": "fix",
      "reason": "hardcoded `arn:aws:` at Properties.ManagedPolicyArns[1]",
      "change": "Build the ARN from the partition instead of the literal.",
      "edits": [
        {
          "path": "Properties.ManagedPolicyArns[1]",
          "find": "arn:aws:",
          "replace": {
            "cloudformation": "arn:${AWS::Partition}:",
            "cdk": "arn:${Aws.PARTITION}:",
            "terraform": "arn:${data.aws_partition.current.partition}:"
          }
        }
      ]
    },
    {
      "logical_id": "Subnet",
      "tier": "flag",
      "reason": "hardcoded `eu-central-1a` at Properties.AvailabilityZone",
      "change": "Choose the zone for `eu-central-1a` in the target. Run in live mode to compare with the target's zones."
    }
